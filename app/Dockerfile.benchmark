FROM denoland/deno:latest
# RUN apt-get update && \
#     apt-get install -y curl unzip default-jre mpv python3 && \
#     curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
#     apt-get install -y nodejs && \
