{
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"indentWidth": 4
	},
	"imports": {
		"@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
		"@deno/dnt": "jsr:@deno/dnt@^0.42.3",
		"@electric-sql/pglite": "npm:@electric-sql/pglite@^0.3.9",
		"@fastify/cookie": "npm:@fastify/cookie@^11.0.2",
		"@fastify/jwt": "npm:@fastify/jwt@^10.0.0",
		"@fastify/send": "npm:@fastify/send@^4.1.0",
		"@fastify/static": "npm:@fastify/static@^8.2.0",
		"@fastify/swagger": "npm:@fastify/swagger@^9.5.2",
		"@fastify/swagger-ui": "npm:@fastify/swagger-ui@^5.2.3",
		"@fastify/type-provider-typebox": "npm:@fastify/type-provider-typebox@^5.2.0",
		"@jd1378/another-cookiejar": "jsr:@jd1378/another-cookiejar@^5.0.7",
		"@makerx/ts-dossier": "npm:@makerx/ts-dossier@^4.0.4",
		"@sinclair/typebox": "npm:@sinclair/typebox@^0.34.41",
		"@std/assert": "jsr:@std/assert@^1.0.14",
		"@std/log": "jsr:@std/log@^0.224.14",
		"@std/path": "jsr:@std/path@^1.1.2",
		"@std/testing": "jsr:@std/testing@^1.0.15",
		"@std/toml": "jsr:@std/toml@^1.0.10",
		"drizzle-seed": "npm:drizzle-seed@^0.3.1",
		"fastify": "npm:fastify@^5.5.0",
		"googleapis": "npm:googleapis@^150.0.1",
		"inversify": "npm:inversify@^7.9.0",
		"iso8601-duration": "npm:iso8601-duration@^2.1.2",
		"ts-mockito": "npm:ts-mockito@^2.6.1",
		"zod": "npm:zod@^3.25.76",
		"@types/pg": "npm:@types/pg@^8.15.5",
		"drizzle-kit": "npm:drizzle-kit@^0.31.4",
		"drizzle-orm/pg-core": "npm:drizzle-orm@^0.44.5/pg-core",
		"pg": "npm:pg@^8.16.3",
		"drizzle-orm/node-postgres": "npm:drizzle-orm@^0.44.5/node-postgres",
		"drizzle-orm/pglite": "npm:drizzle-orm@^0.44.5/pglite",
		"drizzle-orm/pglite/migrator": "npm:drizzle-orm@^0.44.5/pglite/migrator",
		"drizzle-orm": "npm:drizzle-orm@^0.44.5"
	},
	"workspace": [
		"./src/core",
		"./src/database/*",
		"./src/searchers/*",
		"./src/streamers/*",
		"./src/infrastructure",
		"./src/delivery/*",
		"./tests/utils",
		"./tests/components/searchers/in_memory"
	],
	"compilerOptions": {
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"strict": true
	},
	"tasks": {
		"build": "deno compile -o ../../out/podcast --target x86_64-unknown-linux-gnu --allow-env --env-file --allow-net --allow-read --allow-write --allow-run=yt-dlp,mpv ./src/main.ts",
		"run": "deno run --allow-env --env-file --allow-net --allow-read --allow-write --allow-sys --allow-run=yt-dlp ./src/main.ts",
		"test-unit-core": "deno test ./src/core/tests/unit/* ./tests/unit/core/* --allow-env --env-file=./.env.test --allow-read",
		"test-unit-db": "deno test ./tests/unit/database/postgres_lite/* --allow-env --env-file=./.env.test --allow-read",
		"test-int-db": "deno test ./tests/integration/database/postgres/* --allow-env --env-file=./.env.test --allow-read --allow-net",
		"test-int-core": "deno test ./tests/integration/core/* --allow-env --env-file=./.env.test --allow-read --allow-net"
	}
}
